# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Frontend Supabase Configuration (Public Anon / Publishable Key Only)
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-publishable-anon-key"

# Backend Server Supabase Configuration (Configure in server/.env ONLY — never expose to client)
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_SECRET_KEY="your-backend-secret-key"

# Isolated Non-Production Supabase Integration Test Configuration (npm run test:integration)
# Dedicated test project: nekbaar-test (ref: hbnxaqoaoeqaetvgbkgb, region: ap-south-1, PostgreSQL 17)
# Use the legacy anon JWT and legacy service_role JWT issued by this SAME test project.
# The integration suite validates each JWT's project ref and role before making requests.
# NEVER point to production (qbwnzunusmaidciakuod) and NEVER expose TEST_SUPABASE_SERVICE_ROLE_KEY in VITE_ variables.
TEST_SUPABASE_URL="https://hbnxaqoaoeqaetvgbkgb.supabase.co"
TEST_SUPABASE_ANON_KEY="your-test-project-legacy-anon-jwt"
TEST_SUPABASE_SERVICE_ROLE_KEY="your-test-project-legacy-service-role-jwt"
