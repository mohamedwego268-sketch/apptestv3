# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Frontend Supabase Configuration (Public Anon / Publishable Key Only)
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-publishable-anon-key"

# Backend Server Supabase Configuration (Configure in server/.env ONLY — never expose to client)
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_SECRET_KEY="your-backend-secret-key"

# Isolated Non-Production Supabase Integration Test Configuration (npm run test:integration)
# Point ONLY to a local `supabase start` instance or isolated test branch — NEVER production.
TEST_SUPABASE_URL="http://127.0.0.1:54321"
TEST_SUPABASE_ANON_KEY="your-local-or-branch-test-anon-key"
TEST_SUPABASE_SERVICE_ROLE_KEY="your-local-or-branch-test-service-role-key"

